<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvWorkshopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreferredWorkshop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_call"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/preferred_workshop"
            android:textColor="@color/success"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Adres i nawigacja -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWorkshopAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnWorkshopNavigate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button_navigate"
                android:contentDescription="@string/workshop_navigate"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_workshop_navigate_24"
                app:tint="@color/brand_navy" />

        </LinearLayout>

        <!-- Telefon i przycisk połączenia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWorkshopPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnWorkshopCall"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button_call"
                android:contentDescription="@string/workshop_call"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_workshop_call_24"
                app:tint="@color/success" />

        </LinearLayout>

        <!-- Godziny otwarcia -->
        <TextView
            android:id="@+id/tvWorkshopOpeningHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
