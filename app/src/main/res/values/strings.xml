    <!-- Opisy kategorii -->
    <string name="category_periodic_description">Regularne czynności konserwacyjne i przeglądy pomagające utrzymać samochód w dobrym stanie technicznym.</string>

    <string name="category_diagnostics_description">Wybierz tę kategorię, jeśli nie znasz przyczyny problemu lub chcesz sprawdzić stan techniczny samochodu.</string>

    <string name="category_vulcanization_description">Usługi związane z oponami i kołami, zarówno sezonowe, jak i naprawcze.</string>

    <string name="category_repair_description">Wybierz tę kategorię, jeśli znasz usterkę lub chcesz zlecić naprawę konkretnego elementu samochodu.</string>

    <string name="category_other_description">Pozostałe usługi, które nie pasują do żadnej z powyższych kategorii.</string>

